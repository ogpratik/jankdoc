<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Debug/profile builds run unsandboxed: JankDoc.attach() spawns the
		analysis daemon as a child process (and reads ~/.jankdoc), which the
		App Sandbox forbids. Release.entitlements stays sandboxed — JankDoc
		is a no-op in release builds.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!--
		JankDoc opens two localhost connections from the Flutter app:
		- the analysis daemon it spawns on 127.0.0.1:9101
		- Ollama on 127.0.0.1:11434 (via the daemon, not the app)
		The client entitlement covers outgoing localhost HTTP calls.
	-->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
